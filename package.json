{
  "name": "ciranda",
  "version": "4.4.0",
  "private": true,
  "description": "Low-latency screen sharing: a relay-only WebRTC server for Raspberry Pi and a native desktop client",
  "scripts": {
    "install:all": "npm --prefix ./server install",
    "server": "npm --prefix ./server start",
    "client": "cargo run --manifest-path client/Cargo.toml",
    "start": "cargo run --manifest-path client/Cargo.toml",
    "build:client": "cargo build --release --manifest-path client/Cargo.toml"
  },
  "license": "MIT"
}
